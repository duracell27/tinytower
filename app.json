{
  "expo": {
    "name": "Vibe Tower",
    "slug": "tinytower",
    "scheme": "vibetower",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/img/LogoBlack (1).png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shmidt.vibetower",
      "buildNumber": "2",
      "icon": {
        "light": "./assets/img/LogoWhite (1).png",
        "dark": "./assets/img/LogoBlack (1).png",
        "tinted": "./assets/img/LogoBlack (1).png"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/img/LogoBlack (1).png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shmidt.vibetower",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bff54aa5-748b-496a-a69b-0615dcb354cc"
      },
      "router": {}
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.517555712792-vnvtm4lh1s095obu6tanh1qdsbg7d3gf"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#2592AB",
          "defaultChannel": "default",
          "androidCollapsedTitle": "Vibe Tower"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "tinytower-mobile",
          "organization": "vibe-tower",
          "uploadSourceMaps": false
        }
      ],
      "expo-audio"
    ],
    "owner": "duracell27"
  }
}
