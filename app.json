{
  "expo": {
    "name": "Vibe Tower",
    "slug": "tinytower",
    "scheme": "vibetower",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/LogoBlack (1).png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shmidt.vibetower",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/img/LogoWhite (1).png",
        "dark": "./assets/img/LogoBlack (1).png",
        "tinted": "./assets/img/LogoBlack (1).png"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/img/LogoBlack (1).png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.shmidt.vibetower"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-image",
      "expo-font",
      "expo-router",
      "expo-localization",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.517555712792-vnvtm4lh1s095obu6tanh1qdsbg7d3gf"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2592AB",
          "defaultChannel": "default",
          "androidCollapsedTitle": "Vibe Tower"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "tinytower-mobile",
          "organization": "vibe-tower"
        }
      ]
    ]
  }
}
