generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  playerName         String              @unique
  balance            Int                 @default(100)
  stateVersion       Int                 @default(0)
  playerLevel        Int                 @default(1)
  playerXp           Int                 @default(0)
  totalBought        Int                 @default(0)
  totalListed        Int                 @default(0)
  totalCollected        Int                 @default(0)
  totalPassengersLifted Int                 @default(0)
  maxRevenuePerMin   Int                 @default(0)
  openedFloorsCount  Int                 @default(0)
  lastSeenAt         DateTime            @default(now())
  createdAt          DateTime            @default(now())
  referralCode       String?             @unique
  city               String?
  cityMembership     CityMembership?
  referrals          Referral[]          @relation("ReferrerReferrals")
  referredBy         Referral?           @relation("ReferredReferral")
  purchaseNotifications ReferralPurchaseNotification[]
  floors             Floor[]
  workers            Worker[]
  state              PlayerState?
  floorConstructions FloorConstruction[]
  floorTypes         PlayerFloorType[]
  categoryProgress   PlayerCategoryProgress[]
  isAdmin      Boolean     @default(false)
  isTemporary  Boolean     @default(false)
  chatMessages ChatMessage[]
  forumPosts      ForumPost[]
  forumComments   ForumComment[]
  forumPostReads  ForumPostRead[]
  reports         Report[]
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")
  sentMail              MailMessage[]   @relation("SentMail")
  receivedMail          MailMessage[]   @relation("ReceivedMail")
  cityInvitesSent       CityInvite[]    @relation("CityInvitesSent")
  cityInvitesReceived   CityInvite[]    @relation("CityInvitesReceived")
  blocksGiven           Block[]         @relation("BlockerBlocks")
  blocksReceived        Block[]         @relation("BlockedByBlocks")
  cityBudgetTransactions CityBudgetTransaction[] @relation("CityBudgetTransactions")
  cityHistoryActed       CityHistoryEvent[]      @relation("CityHistoryActor")
  cityHistoryTargeted    CityHistoryEvent[]      @relation("CityHistoryTarget")
  purchases              Purchase[]
}

model PlayerState {
  playerId               String  @id
  gems                   Int     @default(20)
  lobbyCapacity          Int     @default(10)
  hotelCapacity          Int     @default(10)
  elevatorLevel          Int     @default(1)
  elevatorFloor          Int     @default(0)
  dailyTips              Float   @default(0)
  dailyGemsCollected     Int     @default(0)
  dailyTipsRewardClaimed Boolean @default(false)
  dailyTipsStage2Claimed Boolean @default(false)
  dailyFillLobbyUses     Int     @default(0)
  lastDailyLoginClaimedAt BigInt  @default(0)
  lastDailyReset         BigInt  @default(0)
  coinBonusPercent       Int     @default(0)
  xpBonusPercent         Int     @default(0)
  coinBoostPercent       Int     @default(0)
  xpBoostPercent         Int     @default(0)
  coinBoostExpiresAt     BigInt  @default(0)
  xpBoostExpiresAt       BigInt  @default(0)
  nextVisitorAt          BigInt  @default(0)
  briks                  Int     @default(1)
  glass                  Int     @default(1)
  nails                  Int     @default(1)
  screw                  Int     @default(1)
  wood                   Int     @default(1)
  cement                 Int     @default(1)
  lobbyVisitors          Json    @default("[]")
  tokenGreen             Int     @default(0)
  tokenBlue              Int     @default(0)
  tokenYellow            Int     @default(0)
  tokenPurple            Int     @default(0)
  tokenRed               Int     @default(0)
  businessUpgradeGreen   Int     @default(0)
  businessUpgradeBlue    Int     @default(0)
  businessUpgradeYellow  Int     @default(0)
  businessUpgradePurple  Int     @default(0)
  businessUpgradeRed     Int     @default(0)
  dailyTasksProgress     Json    @default("{}")
  dailyTasksClaimed      Json    @default("[]")
  dailyTasksDoubleReward Boolean @default(false)
  floorStars             Json    @default("{}")
  tutorialProgress       Json    @default("{}")
  tutorialTasks          Json    @default("{}")
  warehouseLevel         Int     @default(0)
  vehicleTaxi          Int     @default(0)
  vehicleForklift      Int     @default(0)
  vehicleArmoredTruck  Int     @default(0)
  vehicleDeliveryTruck Int     @default(0)
  vehicleBus           Int     @default(0)
  player                 Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model FloorConstruction {
  id                Int     @id @default(autoincrement())
  playerId          String
  floorId           Int
  startedAt         BigInt
  durationMs        Int
  requiredTools     Json
  selectedFloorType String?
  player            Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, floorId])
}

model PlayerFloorType {
  playerId  String
  floorId   Int
  floorType String
  player    Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, floorId])
}

model Floor {
  id          Int          @id @default(autoincrement())
  playerId    String
  floorId     Int
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  productions Production[]

  @@unique([playerId, floorId])
}

model Production {
  id             Int     @id @default(autoincrement())
  floorDbId      Int
  slotIdx        Int
  typeId         String?
  stage          String  @default("IDLE")
  stageStartedAt BigInt  @default(0)
  floor          Floor   @relation(fields: [floorDbId], references: [id], onDelete: Cascade)

  @@unique([floorDbId, slotIdx])
}

model Worker {
  id              String  @id
  playerId        String
  name            String
  female          Boolean
  floorType       String
  dreamJob        String
  level           Int
  isSpecialist    Boolean @default(false)
  hairColor       String
  assignedFloorId Int?
  assignedSlotIdx Int?
  player          Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
}

model CommandLog {
  id          String   @id
  playerId    String
  type        String
  floorId     Int?
  slotIdx     Int?
  typeId      String?
  workerId    String?
  timestamp   BigInt
  serverTime  BigInt
  cursor      Int      @default(autoincrement())
  processedAt DateTime @default(now())

  @@index([playerId, cursor])
}

model PlayerCategoryProgress {
  playerId      String
  categoryKey   String
  progress      Int        @default(0)
  currentLevel  Int        @default(0)
  claimedLevels Int[]      @default([])
  updatedAt     DateTime   @updatedAt
  player        Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, categoryKey])
  @@index([playerId])
}

model Referral {
  id                   String    @id @default(uuid())
  referrerId           String
  referredId           String    @unique
  referredName         String
  createdAt            DateTime  @default(now())
  registeredClaimedAt  DateTime?
  level10ReachedAt     DateTime?
  level10ClaimedAt     DateTime?
  level30ReachedAt     DateTime?
  level30ClaimedAt     DateTime?
  gemBonusEarned       Int       @default(0)
  referrer             Player    @relation("ReferrerReferrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred             Player    @relation("ReferredReferral", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model ReferralPurchaseNotification {
  id             String    @id @default(uuid())
  referrerId     String
  referredName   String
  bonus          Int
  purchaseAmount Int
  createdAt      DateTime  @default(now())
  syncedAt       DateTime?
  referrer       Player    @relation(fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId, syncedAt])
}

model ChatMessage {
  id          String    @id @default(uuid())
  playerId    String
  playerName  String
  playerLevel Int       @default(1)
  country     String?
  body        String    @db.VarChar(300)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  reportCount Int     @default(0)
  isHidden    Boolean @default(false)
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([country, createdAt])
}

enum ForumCategory {
  NEWS
  HELP
  GENERAL
  CITIES
  PURCHASES
}

model ForumPost {
  id           String          @id @default(uuid())
  playerId     String
  playerName   String
  playerLevel  Int
  category     ForumCategory
  title        String          @db.VarChar(200)
  body         String          @db.VarChar(5000)
  isPinned     Boolean         @default(false)
  isClosed     Boolean         @default(false)
  commentCount Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  reportCount Int     @default(0)
  isHidden    Boolean @default(false)
  player       Player          @relation(fields: [playerId], references: [id], onDelete: Cascade)
  comments     ForumComment[]
  reads        ForumPostRead[]

  @@index([category, isPinned, createdAt])
  @@index([deletedAt])
}

model ForumComment {
  id          String    @id @default(uuid())
  postId      String
  playerId    String
  playerName  String
  playerLevel Int
  body        String    @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  reportCount Int     @default(0)
  isHidden    Boolean @default(false)
  post        ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
}

model ForumPostRead {
  playerId             String
  postId               String
  lastSeenCommentCount Int       @default(0)
  post                 ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  player               Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([playerId, postId])
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ReportTargetType {
  CHAT_MESSAGE
  FORUM_POST
  FORUM_COMMENT
}

enum ReportCategory {
  SPAM
  HARASSMENT
  ADVERTISEMENT
  PROFANITY
  THREAT
  ADULT_CONTENT
  OTHER
}

model FriendRequest {
  id        String              @id @default(uuid())
  fromId    String
  toId      String
  status    FriendRequestStatus @default(PENDING)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  from      Player              @relation("SentRequests", fields: [fromId], references: [id], onDelete: Cascade)
  to        Player              @relation("ReceivedRequests", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId])
  @@index([toId, status])
  @@index([fromId, status])
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   Player   @relation("BlockerBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Player   @relation("BlockedByBlocks", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
}

model MailMessage {
  id            String   @id @default(uuid())
  fromId        String
  toId          String
  subject       String
  body          String
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  cityInviteId  String?  @unique

  from       Player      @relation("SentMail",     fields: [fromId], references: [id], onDelete: Cascade)
  to         Player      @relation("ReceivedMail", fields: [toId],   references: [id], onDelete: Cascade)
  cityInvite CityInvite? @relation(fields: [cityInviteId], references: [id], onDelete: SetNull)

  @@index([toId, isRead])
  @@index([toId, createdAt])
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  category   ReportCategory
  createdAt  DateTime         @default(now())
  reporter   Player           @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

enum CityRole {
  MAYOR
  ACTING_MAYOR
  VICE_MAYOR
  ADVISOR
  BUSINESSMAN
  CITIZEN
  NEWBIE
}

model City {
  id            String           @id @default(uuid())
  name          String           @unique @db.VarChar(30)
  description   String?          @db.VarChar(500)
  cityXp        Int              @default(0)
  xpPeriodStart DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  budgetCoins       Int       @default(0)
  budgetGems        Int       @default(0)
  budgetBriks       Int       @default(0)
  budgetGlass       Int       @default(0)
  budgetNails       Int       @default(0)
  budgetScrew       Int       @default(0)
  budgetWood        Int       @default(0)
  budgetCement      Int       @default(0)
  budgetLastResetAt DateTime?
  members       CityMembership[]
  invites       CityInvite[]
  budgetTransactions CityBudgetTransaction[]
  historyEvents  CityHistoryEvent[]
}

model CityMembership {
  cityId    String
  playerId  String   @id
  role      CityRole @default(NEWBIE)
  cityXp    Int      @default(0)
  xpPeriod  Int      @default(0)
  joinedAt  DateTime @default(now())
  gemsGivenThisWeek Int      @default(0)
  gemsShopBonus     Int      @default(0)
  gemsWeekStart     DateTime @default(now())
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([cityId])
}

enum CityInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model CityInvite {
  id              String           @id @default(uuid())
  token           String           @unique @default(uuid())
  cityId          String
  invitedById     String
  invitedPlayerId String
  status          CityInviteStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  expiresAt       DateTime

  city          City   @relation(fields: [cityId], references: [id], onDelete: Cascade)
  invitedBy     Player @relation("CityInvitesSent",     fields: [invitedById],     references: [id], onDelete: Cascade)
  invitedPlayer Player @relation("CityInvitesReceived", fields: [invitedPlayerId], references: [id], onDelete: Cascade)
  mail          MailMessage?

  @@index([invitedPlayerId, status])
  @@index([cityId])
}

model CityBudgetTransaction {
  id        String   @id @default(uuid())
  cityId    String
  playerId  String?
  type      String
  coins     Int      @default(0)
  gems      Int      @default(0)
  briks     Int      @default(0)
  glass     Int      @default(0)
  nails     Int      @default(0)
  screw     Int      @default(0)
  wood      Int      @default(0)
  cement    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  player Player? @relation("CityBudgetTransactions", fields: [playerId], references: [id], onDelete: SetNull)

  @@index([cityId, createdAt])
}

model CityHistoryEvent {
  id         String   @id @default(uuid())
  cityId     String
  eventType  String
  actorId    String?
  actorName  String
  targetId   String?
  targetName String?
  fromRole   String?
  toRole     String?
  toLevel    Int?
  createdAt  DateTime @default(now())

  city   City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  actor  Player? @relation("CityHistoryActor", fields: [actorId], references: [id], onDelete: SetNull)
  target Player? @relation("CityHistoryTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([cityId, createdAt])
}

model Purchase {
  id            String   @id @default(uuid())
  playerId      String
  transactionId String   @unique
  packId        String
  rcProductId   String
  status        String
  gemsGranted   Int      @default(0)
  toolsGranted  Json?
  tokensGranted Json?
  source        String
  createdAt     DateTime @default(now())

  player        Player   @relation(fields: [playerId], references: [id])

  @@index([playerId])
}
